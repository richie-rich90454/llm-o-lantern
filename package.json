{
    "name": "llm-o-lantern",
    "version": "0.1.0",
    "private": true,
    "description": "A modular, local-first, conversational 3D jack-o'-lantern for a Halloween booth.",
    "type": "module",
    "packageManager": "pnpm@12.14.0",
    "engines": {
        "node": ">=20.11"
    },
    "scripts": {
        "setup": "tsx scripts/setupServices.ts",
        "icons": "tsx scripts/generateIcons.ts",
        "dev": "concurrently -n api,web -c yellow,magenta \"pnpm:dev:server\" \"pnpm:dev:web\"",
        "dev:server": "tsx --disable-warning=ExperimentalWarning watch src/server/server.ts",
        "dev:web": "vite",
        "build": "vite build",
        "start": "tsx --disable-warning=ExperimentalWarning src/server/server.ts",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "format": "oxfmt .",
        "format:check": "oxfmt --check ."
    },
    "dependencies": {
        "three": "^0.186.1"
    },
    "devDependencies": {
        "@resvg/resvg-js": "^2.6.2",
        "@types/node": "^26.6.5",
        "@types/three": "^0.186.0",
        "concurrently": "^10.0.6",
        "oxfmt": "^0.73.0",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vite": "^8.3.4",
        "vitest": "^5.0.5"
    }
}
