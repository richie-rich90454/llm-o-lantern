{
  "name": "llm-o-lantern",
  "version": "0.1.0",
  "private": true,
  "description": "A modular, local-first, conversational 3D jack-o'-lantern for a Halloween booth.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "setup": "tsx scripts/setupServices.ts",
    "dev": "concurrently -n api,web -c yellow,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/server.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx src/server/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
