# llm-o-lantern — environment overrides
# Copy this file to ".env" and adjust. Every value is optional; the JSON
# configuration file and the built-in defaults apply first. Environment
# variables always win over the JSON file.
#
# After `npm install`, run `npm run setup` once: it downloads the local
# speech services (whisper.cpp + Piper) into ./services so `npm start` can
# launch the complete booth.

# ---------------------------------------------------------------------------
# Dialogue — OpenCode Go (the shipped default provider)
# ---------------------------------------------------------------------------
# `opencode auth login` stores the key for you; the booth reads it from
# ~/.local/share/opencode/auth.json automatically. Set OPENCODE_API_KEY here
# only if you prefer an environment variable.
# Notes: requests are routed with the mandatory x-opencode-session header
# (sent per visitor session for cache affinity), and the deepseek-v4.1-flash
# model requires your opencode.ai workspace Privacy setting to be "Global".
# OPENCODE_API_KEY=

# ---------------------------------------------------------------------------
# Dialogue — OpenRouter (configured failover provider)
# ---------------------------------------------------------------------------
# Get a free key at https://openrouter.ai/settings/keys and paste it below.
# Without a key the booth still runs and answers with the scripted fallback
# dialogue.
OPENROUTER_API_KEY=

# Which model the remote dialogue provider serves. This is the switch for
# changing models: no code or config file edits needed. Any OpenRouter model
# works, including ":free" variants. Examples:
#   nvidia/nemotron-3.5-super-vl:free
#   deepseek/deepseek-r1:free
#   meta-llama/llama-3.3-70b-instruct:free
LLMOL_DIALOGUE_MODEL=nvidia/nemotron-3.5-super-vl:free

# Optional: switch the remote provider preset (openai, anthropic, deepseek,
# openrouter, groq, mistral, together, xai, perplexity, fireworks, llamacpp,
# vllm, lmstudio, ollama-openai).
# LLMOL_DIALOGUE_PRESET=openrouter

# ---------------------------------------------------------------------------
# Other remote dialogue providers (only used when dialogue.remote.preset is
# changed in llm-o-lantern.config.json). Keys are read on the backend only and
# are never sent to the browser or written to logs.
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# TOGETHER_API_KEY=
# XAI_API_KEY=
# PERPLEXITY_API_KEY=
# FIREWORKS_API_KEY=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# LLMOL_HOST=127.0.0.1
# LLMOL_PORT=8787
# Path to the JSON configuration file (default: ./llm-o-lantern.config.json)
# LLMOL_CONFIG=llm-o-lantern.config.json

# ---------------------------------------------------------------------------
# Logging (debug | info | warn | error)
# ---------------------------------------------------------------------------
# LLMOL_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Local LLM: Ollama (optional alternative provider; keep local-first by
# setting plugins.dialogue to "dialogue.ollama" in llm-o-lantern.config.json)
# ---------------------------------------------------------------------------
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
# OLLAMA_KEEP_ALIVE=30m

# ---------------------------------------------------------------------------
# Local speech services
# ---------------------------------------------------------------------------
# Base URL of the local Whisper-compatible speech recognition server.
# LLMOL_STT_BASE_URL=http://127.0.0.1:8082
# Base URL of the local neural text-to-speech server (Kokoro-FastAPI compatible).
# LLMOL_TTS_BASE_URL=http://127.0.0.1:8880
